DATABASE_URL="postgresql://gocafe:gocafe@localhost:5432/gocafe?schema=public"
PORT=4000

# Clave para firmar los tokens de sesión. Usar un valor largo y aleatorio.
JWT_SECRET="reemplazar-por-un-valor-secreto"

CORS_ORIGIN="http://localhost:5173"

# Usuario administrador creado por "npm run seed".
SEED_USERNAME="admin"
SEED_PASSWORD="reemplazar-por-una-contraseña"

# Dirección pública del frontend (enlaces de seguimiento y tarjetas de Google Wallet).
# Si se omite se usa CORS_ORIGIN. En la nube debe ser https://...
# PUBLIC_URL="https://gocafe.onrender.com"

# Google Wallet (opcional). ID de la entidad emisora de la consola de Google Pay & Wallet
# y la clave JSON de la cuenta de servicio: como archivo (desarrollo) o pegada completa
# en GOOGLE_WALLET_CREDENTIALS (Render). La clave nunca se sube a GitHub.
# GOOGLE_WALLET_ISSUER_ID="3388000000000000000"
# GOOGLE_WALLET_KEY_FILE="secrets/google-wallet.json"
# GOOGLE_WALLET_CREDENTIALS=
# "no" oculta el botón a los clientes mientras Google no aprueba el acceso de publicación.
# GOOGLE_WALLET_BOTON="si"
